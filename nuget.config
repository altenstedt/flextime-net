<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org: a feed configured on the machine must never take part in a restore. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
